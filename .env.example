# =============================================================================
# CivicPulse Environment Configuration
# =============================================================================
# Copy this file to .env and customize for your environment.
# python-decouple loads variables from .env automatically.
#
# Configuration priority (highest to lowest):
# 1. Environment variables (production/CI)
# 2. .env file (local development)
# 3. Code defaults (fallback only)
# =============================================================================

# =============================================================================
# REQUIRED - Django Core Settings
# =============================================================================

# SECURITY: Generate a unique secret key for production!
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here-generate-a-secure-50-char-key

# Set to False in production
DEBUG=true

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1,pop-os.tailb56d83.ts.net

# CSRF trusted origins for cross-origin POST requests (Django 4.0+)
# Must include scheme (http:// or https://)
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,https://pop-os.tailb56d83.ts.net


# =============================================================================
# DATABASE - GeoDjango Configuration
# =============================================================================

# Database engine (leave empty for auto-detection)
# Options:
#   (empty) - Auto-detect: SpatiaLite if available, else SQLite
#   django.contrib.gis.db.backends.spatialite - SQLite with spatial support
#   django.contrib.gis.db.backends.postgis - PostgreSQL with PostGIS
#   django.db.backends.sqlite3 - Standard SQLite (limited spatial features)
DB_ENGINE=

# Database name (path for SQLite, database name for PostgreSQL)
DB_NAME=db.sqlite3

# PostgreSQL-only settings (ignored for SQLite/SpatiaLite)
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# GIS Library Paths (usually auto-detected)
# Ubuntu/Debian: /usr/lib/x86_64-linux-gnu/mod_spatialite.so
# macOS: /opt/homebrew/lib/mod_spatialite.dylib
# SPATIALITE_LIBRARY_PATH=
# GDAL_LIBRARY_PATH=


# =============================================================================
# REDIS - Cache and Message Broker
# =============================================================================

# Redis URL for caching (geocoding results, route optimization)
REDIS_URL=redis://localhost:6379/1

# Celery message broker URL
CELERY_BROKER_URL=redis://localhost:6379/0


# =============================================================================
# CIVICPULSE - Application Settings
# =============================================================================

# Site branding
CIVICPULSE_SITE_NAME=CivicPulse

# Lock timeout for concurrent user support (minutes)
# After this time, abandoned locks are released
CIVICPULSE_LOCK_TIMEOUT=10

# Enable django-compressor for CSS compression
# Requires django-compressor to be installed
CIVICPULSE_USE_COMPRESSOR=false

# Include default navigation bar in templates
CIVICPULSE_INCLUDE_NAV=true


# =============================================================================
# ROUTING SERVICES - Route Optimization (Optional)
# =============================================================================
# CivicPulse uses a fallback chain for route optimization:
# 1. Local OSRM (if OSRM_URL is set) - Self-hosted, no rate limits
# 2. OpenRouteService (if API key is set) - 2,000 requests/day free
# 3. OSRM Demo Server - Public fallback, rate-limited
# 4. Nearest Neighbor - Always works, straight-line distance

# Local OSRM server URL (e.g., Docker: http://localhost:5000)
# OSRM_URL=

# OpenRouteService API key - Get free key at: https://openrouteservice.org/
# OPENROUTESERVICE_API_KEY=


# =============================================================================
# GEOCODING - Address to Coordinates (Optional)
# =============================================================================

# OpenCage geocoding API key - Get free key at: https://opencagedata.com/
# Free tier: 2,500 requests/day
# OPENCAGE_API_KEY=


# =============================================================================
# STRIPE CONNECT - Campaign Finance Integration (Optional)
# =============================================================================
# Stripe Connect allows candidates and campaigns to link their Stripe accounts
# for donation tracking. Tokens are encrypted at rest using Fernet.

# Stripe Connect OAuth credentials - Get from: https://dashboard.stripe.com/settings/connect
# CLIENT_ID: Found in Connect Settings (ca_xxxxx)
# SECRET_KEY: Your Stripe secret key (sk_test_xxxxx or sk_live_xxxxx)
# STRIPE_CLIENT_ID=
# STRIPE_SECRET_KEY=

# Webhook signing secret - Get from: https://dashboard.stripe.com/webhooks
# Used to verify incoming webhook events are from Stripe
# STRIPE_WEBHOOK_SECRET=

# Fernet encryption key for storing OAuth tokens at rest
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# IMPORTANT: This key must remain constant - changing it will invalidate all stored tokens
# STRIPE_ENCRYPTION_KEY=
